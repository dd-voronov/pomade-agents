{
  "id": "pomade-agents",
  "name": "Agents",
  "version": "0.1.0",
  "hostApi": 0,
  "icon": "agents.svg",
  "capabilities": [
    "project.read",
    "agentTabs.read"
  ],
  "strip": [
    {
      "id": "agents",
      "title": "Agents",
      "action": "panel"
    }
  ],
  "events": {
    "publish": [
      "sessions.changed",
      "roster.changed",
      "session.turnFinished",
      "session.closed",
      "session.statusChanged"
    ],
    "subscribe": [
      "pomade-agents:sessions.changed",
      "pomade-agents:roster.changed",
      "pomade.ready",
      "project.created",
      "project.renamed",
      "agentTab.changed",
      "agentTab.exited"
    ]
  },
  "backend": {
    "entry": "backend/main.mjs",
    "mode": "with-pomade"
  },
  "api": [
    "app.info",
    "sessions.list",
    "sessions.setStatus",
    "sessions.rename",
    "sessions.moveToProject",
    "sessions.forRepo",
    "sessions.liveIn",
    "sessions.get",
    "sessions.lastMessage",
    "sessions.find",
    "roster.list",
    "roster.launchSpec",
    "roster.projectsFor",
    "roster.agentsFor",
    "roster.agents"
  ],
  "outsideWorkspace": [
    "~/.claude/",
    "~/.codex/",
    "~/.zshrc"
  ]
}
