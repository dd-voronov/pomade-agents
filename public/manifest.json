{
  "id": "pomade-agents",
  "name": "Agents",
  "version": "0.1.0",
  "hostApi": 0,
  "icon": "agents.svg",
  "capabilities": [
    "project.read",
    "agentTabs.read",
    "agentTabs.write",
    "tabs.open",
    "files.read",
    "project.write"
  ],
  "strip": [
    {
      "id": "agents",
      "title": "Agents",
      "action": "panel"
    }
  ],
  "events": {
    "publish": [
      "sessions.changed",
      "roster.changed",
      "liveNow.changed",
      "session.turnFinished",
      "session.closed",
      "session.statusChanged",
      "skills.changed",
      "roster.creating"
    ],
    "subscribe": [
      "pomade-agents:sessions.changed",
      "pomade-agents:roster.changed",
      "pomade-agents:liveNow.changed",
      "pomade.ready",
      "project.created",
      "project.renamed",
      "project.removed",
      "agentTab.changed",
      "agentTab.exited",
      "pomade-runner:run.started",
      "pomade-runner:run.finished",
      "pomade-agents:skills.changed",
      "pomade-agents:roster.creating"
    ]
  },
  "backend": {
    "entry": "backend/main.mjs",
    "mode": "with-pomade"
  },
  "api": [
    "app.info",
    "sessions.list",
    "sessions.setStatus",
    "sessions.rename",
    "sessions.moveToProject",
    "sessions.forRepo",
    "sessions.liveIn",
    "sessions.get",
    "sessions.lastMessage",
    "sessions.find",
    "sessions.open",
    "liveNow.list",
    "roster.list",
    "roster.launchSpec",
    "roster.projectsFor",
    "roster.agentsFor",
    "roster.agents",
    "sessions.ofTab",
    "sessions.agentCounts",
    "skills.catalog",
    "settings.setSkillFolders",
    "roster.checkName",
    "roster.create",
    "roster.checkAlias",
    "roster.updateProfile",
    "roster.permissions",
    "roster.memory",
    "roster.modelConfig",
    "roster.setModel"
  ],
  "commands": [
    {
      "name": "pomade-agents",
      "entry": "cli/pomade-agents.mjs",
      "title": "A session's name, status, note and numbers, for agents and scripts"
    }
  ],
  "skills": [
    "skills/pomade-agents-sessions"
  ],
  "outsideWorkspace": [
    "~/.claude/",
    "~/.codex/",
    "~/.zshrc"
  ]
}
